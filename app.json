{
  "expo": {
    "name": "FinTrack",
    "slug": "fintrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fintrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "android": {
      "package": "com.fintrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0FA3A3"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FinTrack memakai biometrik untuk membuka aplikasi."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FinTrack membutuhkan akses foto untuk melampirkan struk.",
          "cameraPermission": "FinTrack membutuhkan kamera untuk memotret struk."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {}
    }
  }
}
